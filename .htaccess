# Micro-crèches Loupiala — configuration Apache (OVH, o2switch, Hostinger…)
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset UTF-8

# Forcer HTTPS et le www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.loupiala.fr/$1 [L,R=301]

# Redirections 301 depuis l'ancien site Jimdo (conserve le référencement acquis)
Redirect 301 "/qui-sommes-nous/" "https://www.loupiala.fr/qui-sommes-nous.html"
Redirect 301 "/qui-sommes-nous/notre-équipe/" "https://www.loupiala.fr/qui-sommes-nous.html"
Redirect 301 "/qui-sommes-nous/nos-partenaires/" "https://www.loupiala.fr/qui-sommes-nous.html"
Redirect 301 "/les-micro-crèches/" "https://www.loupiala.fr/micro-creches.html"
Redirect 301 "/inscription/" "https://www.loupiala.fr/inscription.html"
Redirect 301 "/actualités/" "https://www.loupiala.fr/actualites.html"
Redirect 301 "/contact/" "https://www.loupiala.fr/contact.html"
Redirect 301 "/foire-aux-questions/" "https://www.loupiala.fr/faq.html"
Redirect 301 "/foire-aux-questions/coût/" "https://www.loupiala.fr/tarifs-aides-caf.html"
Redirect 301 "/foire-aux-questions/prestations/" "https://www.loupiala.fr/tarifs-aides-caf.html"
Redirect 301 "/about/" "https://www.loupiala.fr/mentions-legales.html"
Redirect 301 "/sitemap/" "https://www.loupiala.fr/sitemap.xml"

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml
</IfModule>
